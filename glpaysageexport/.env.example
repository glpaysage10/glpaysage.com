# Copier ce fichier en .env.local et renseigner les vraies valeurs.
# Ne jamais commettre .env.local (déjà ignoré par .gitignore).

# --- Envoi des emails de devis (Brevo) ---
# Requis pour que le formulaire de devis puisse envoyer les emails de
# confirmation client et de notification à l'entreprise.
BREVO_API_KEY=xkeysib-votre-cle-api-brevo
# Adresse expéditrice, doit être un expéditeur vérifié/authentifié dans Brevo.
BREVO_SENDER_EMAIL=contact@votre-domaine.fr
# Optionnel : nom affiché comme expéditeur. Par défaut, le nom du site.
BREVO_SENDER_NAME=GLPaysage
# Optionnel : adresse qui reçoit les notifications de nouvelle demande de
# devis. Par défaut, l'email de contact défini dans src/lib/site-config.ts.
DEVIS_NOTIFICATION_EMAIL=contact@votre-domaine.fr

# --- Supabase (espace admin + enregistrement des demandes de devis) ---
# Optionnel : si ces variables sont absentes, le site fonctionne normalement
# (les emails de devis sont tout de même envoyés), mais l'espace /admin reste
# inaccessible et les demandes ne sont pas enregistrées en base.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-supabase
# Clé service role : ne JAMAIS exposer côté client, utilisée uniquement côté
# serveur (API admin, enregistrement des demandes).
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-supabase

# --- Autocomplétion d'adresse (Google Places) ---
# Optionnel : sans cette variable, le champ adresse du formulaire de devis
# reste un simple champ texte, sans autocomplétion.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=votre-cle-api-google-maps
